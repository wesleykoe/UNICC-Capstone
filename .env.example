# Copy this file to .env and fill in your HuggingFace token
# Get your token at https://huggingface.co/settings/tokens

HF_TOKEN=hf_your_token_here
UNICC_DELIBERATION_ACTIVE=true

# LLM Backend — set to "anthropic" to use Claude instead of local Llama
# Recommended for evaluation: set LLM_BACKEND=anthropic and provide your API key
LLM_BACKEND=local
ANTHROPIC_API_KEY=your_anthropic_api_key_here
